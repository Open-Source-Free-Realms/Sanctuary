{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Play",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build DevClient",
      "program": "${workspaceFolder}/src/Sanctuary.DevClient/bin/Debug/net9.0/Sanctuary.DevClient.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Login",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Sanctuary.Login/bin/Debug/net9.0/Sanctuary.Login.dll",
      "cwd": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "Database__Provider": "Sqlite",
        "Database__ConnectionString": "Data Source=${workspaceFolder}/sanctuary.db",
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Gateway",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Sanctuary.Gateway/bin/Debug/net9.0/Sanctuary.Gateway.dll",
      "cwd": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "Database__Provider": "Sqlite",
        "Database__ConnectionString": "Data Source=${workspaceFolder}/sanctuary.db",
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "WebAPI",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Sanctuary.WebAPI/bin/Debug/net9.0/Sanctuary.WebAPI.dll",
      "cwd": "${workspaceFolder}/src/Sanctuary.WebAPI",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "Database__Provider": "Sqlite",
        "Database__ConnectionString": "Data Source=${workspaceFolder}/sanctuary.db",
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Client",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Sanctuary.DevClient/bin/Debug/net9.0/Sanctuary.DevClient.dll",
      "args": ["--no-servers"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ],
  "compounds": [
    {
      "name": "Servers + WebAPI + Client",
      "preLaunchTask": "build",
      "configurations": [
        "Login",
        "Gateway",
        "WebAPI",
        "Client"
      ],
      "stopAll": true
    },
    {
      "name": "Servers (Login + Gateway)",
      "preLaunchTask": "build",
      "configurations": [
        "Login",
        "Gateway"
      ],
      "stopAll": true
    },
    {
      "name": "Servers + WebAPI",
      "preLaunchTask": "build",
      "configurations": [
        "Login",
        "Gateway",
        "WebAPI"
      ],
      "stopAll": true
    }
  ]
}
