<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
	  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<targets>
		<target name="colouredConsole" xsi:type="ColoredConsole" layout="${time:format=HH\:mm\:ss} ${message}${exception:format=tostring}" />
		<target name="chatFile" xsi:type="File" fileName="${basedir}/Logs/Chat-${shortdate}.log" />
		<target name="infoFile" xsi:type="File" fileName="${basedir}/Logs/${processname}-Info-${shortdate}.log" />
		<target name="errorFile" xsi:type="File" fileName="${basedir}/Logs/${processname}-Error-${shortdate}.log" />
	</targets>
	<rules>
		<logger name="Microsoft.EntityFrameworkCore.*" maxLevel="Warn" final="true" />

		<logger name="Chat" minlevel="Info" writeTo="chatFile,colouredConsole" final="true" />
		<logger name="ServerEvents" minlevel="Info" writeTo="colouredConsole" />
		<logger name="Sanctuary.Gateway.GatewayServer" minlevel="Info" maxlevel="Info" writeTo="colouredConsole" />
		<logger name="Sanctuary.Gateway.GatewayConnection" minlevel="Info" maxlevel="Info" writeTo="colouredConsole" />
		<logger name="Sanctuary.Gateway.LoginConnection" minlevel="Info" maxlevel="Info" writeTo="colouredConsole" />
		<logger name="Sanctuary.Gateway.GatewayService" minlevel="Info" maxlevel="Info" writeTo="colouredConsole" />
		<logger name="Microsoft.Hosting.Lifetime" minlevel="Info" maxlevel="Info" writeTo="colouredConsole" />
		<logger name="*" minlevel="Warn" writeTo="colouredConsole" />
		<logger name="*" minlevel="Info" maxlevel="Info" writeTo="infoFile" />
		<logger name="*" minlevel="Warn" maxlevel="Fatal" writeTo="errorFile" />
	</rules>
</nlog>
